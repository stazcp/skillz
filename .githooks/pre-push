#!/usr/bin/env bash
# pre-push: refuse to publish a private term. Scans every commit about to be
# pushed (and not already on that remote), every pushed ref name and every
# annotated tag with scripts/leak-check, and blocks the push on any hit or on
# any setup error (no term list, no python3): it fails closed.
#
# Enable once per clone:  git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)" || exit 1
if [ ! -f "$root/scripts/leak-check" ]; then
  echo "pre-push: $root/scripts/leak-check is missing; refusing to push unchecked." >&2
  exit 1
fi
exec python3 -I "$root/scripts/leak-check" --pre-push "${1:?pre-push needs the remote name}" "${2:-}"
