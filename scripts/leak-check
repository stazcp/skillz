#!/usr/bin/env python3
"""Fail if a private term appears in anything this public repo would publish.

  python3 -I scripts/leak-check --range BASE HEAD    every commit in BASE..HEAD
  python3 -I scripts/leak-check --pre-push REMOTE [URL]   git's pre-push stdin
  python3 -I scripts/leak-check --all                every ref, tag and commit
  python3 -I scripts/leak-check --text-env VAR | --text-file PATH
Add to any mode: --ref-name NAME, --text-env VAR, --text-file PATH (repeatable),
and --worktree (uncommitted and untracked files).

For each commit it scans the raw commit object (author, committer, message and
other headers), the full new content of every file the commit adds or
modifies, every path it adds, deletes or renames, and symlink targets. Content
is raw blob bytes: .gitattributes, textconv and filters are ignored; UTF-8,
cp1252, UTF-16 and UTF-32 decodings are all tried, and zip and gzip members
are opened. --pre-push also scans every pushed ref name and annotated tag.

Terms come from $PRIVATE_TERMS (newline-separated) when it is set, else from
the file $PRIVATE_TERMS_FILE, default ${SKILLZ_CONTEXT:-~/.config/skillz}/
private-terms. Blank lines and # comments are skipped. Terms and text are
normalized alike (NFKC, casefold, invisible characters removed, whitespace
runs, newlines included, collapsed to one space), and each item (a file, a
message, a name) is matched whole, so a term split by a line wrap, a
zero-width character or extra spacing still matches. HTML comments, tags and
entities and %-escapes are also undone in a second pass.

Output never contains a term. Locally it names each hit's location and the
term's number in the list (a name that itself holds a term is withheld). With
GITHUB_ACTIONS=true it prints only "leak-check: FAIL" or "leak-check: clean".

Exit: 0 clean, 1 a term matched, 2 usage or setup error (no terms included).
"""
import gzip
import html
import io
import os
import re
import subprocess
import sys
import unicodedata
import urllib.parse
import zipfile
import zlib

CI = os.environ.get("GITHUB_ACTIONS") == "true"
NULL_SHA = re.compile(r"\A0+\Z")
MAX_INFLATE = 64 << 20          # per archive member
MAX_INFLATE_TOTAL = 256 << 20   # per archive


class SetupError(Exception):
    pass


def local(value):
    """A user-supplied value for an error message: shown locally, never in CI."""
    return "" if CI else " (%s)" % value


# ---------- normalization ----------

def _ignorable():
    cps = [0x0000, 0xFFFD, 0x034F, 0x115F, 0x1160, 0x3164, 0xFFA0]
    cps += list(range(0x180B, 0x1810)) + list(range(0xFE00, 0xFE10)) + list(range(0xE0100, 0xE01F0))
    for rng in (range(0, 0x20000), range(0xE0000, 0xE1000)):
        cps += [cp for cp in rng if unicodedata.category(chr(cp)) == "Cf"]
    return dict.fromkeys(cps)


IGNORABLE = _ignorable()  # every format char (zero-width, bidi, soft hyphen, BOM), NUL, U+FFFD
WS = re.compile(r"\s+")
COMMENT = re.compile(r"<!--.*?(?:-->|\Z)", re.S)
TAG = re.compile(r"<[^<>]*>")
NAME_SEP = re.compile(r"[-_./\\+]+")
MARKDOWN = re.compile(r"[*_~`\\]")


def norm(s):
    s = unicodedata.normalize("NFKC", s.translate(IGNORABLE)).casefold()
    s = unicodedata.normalize("NFKC", s).translate(IGNORABLE)
    return WS.sub(" ", s)


def forms(s, name=False):
    """The normalized texts to match: as is, then with markup and escapes undone."""
    out = [s]
    if "<" in s or "&" in s:
        bare = COMMENT.sub("", s)
        out += [html.unescape(TAG.sub("", bare)), html.unescape(TAG.sub(" ", bare))]
    if "%" in s:
        out += [urllib.parse.unquote(t) for t in list(out)]
    if MARKDOWN.search(s):  # a**b**c renders as one word, abc
        out += [MARKDOWN.sub("", t) for t in list(out)]
    if name:  # ref names and paths: a-b, a_b and a/b also read as "a b"
        out += [NAME_SEP.sub(" ", t) for t in list(out)]
    return {norm(t) for t in out}


def decodings(b):
    out = []
    try:
        out.append(b.decode("utf-8"))
    except UnicodeDecodeError:
        out += [b.decode("utf-8", "replace"), b.decode("cp1252", "replace")]
    if b"\x00" in b or b[:2] in (b"\xff\xfe", b"\xfe\xff"):
        for enc in ("utf-16-le", "utf-16-be"):
            out += [b[off:].decode(enc, "replace") for off in (0, 1)]
        if b"\x00\x00\x00" in b or b[:4] in (b"\xff\xfe\x00\x00", b"\x00\x00\xfe\xff"):
            for enc in ("utf-32-le", "utf-32-be"):
                out += [b[off:].decode(enc, "replace") for off in range(4)]
    return out


def _inflate_gzip(b):
    try:
        return zlib.decompressobj(16 + zlib.MAX_WBITS).decompress(b, MAX_INFLATE)
    except zlib.error:
        return None


def expand(b, depth=0):
    """b itself, then the names and contents of zip and gzip members (bounded)."""
    yield b
    if depth >= 3:
        return
    if b[:2] == b"\x1f\x8b":
        inner = _inflate_gzip(b)
        if inner:
            for x in expand(inner, depth + 1):
                yield x
    elif b"PK\x05\x06" in b[-65557:]:
        try:
            with zipfile.ZipFile(io.BytesIO(b)) as z:
                total = 0
                for info in z.infolist()[:10000]:
                    yield info.filename.encode("utf-8", "surrogateescape")
                    if info.is_dir() or info.file_size > MAX_INFLATE or total > MAX_INFLATE_TOTAL:
                        continue
                    try:
                        data = z.read(info)
                    except Exception:
                        continue
                    total += len(data)
                    for x in expand(data, depth + 1):
                        yield x
        except Exception:
            return


# ---------- terms ----------

def load_terms():
    if "PRIVATE_TERMS" in os.environ:
        raw = os.environb.get(b"PRIVATE_TERMS", b"")
        where = "PRIVATE_TERMS"
    else:
        ctx = os.environ.get("SKILLZ_CONTEXT") or os.path.expanduser("~/.config/skillz")
        path = os.environ.get("PRIVATE_TERMS_FILE") or os.path.join(ctx, "private-terms")
        where = path
        try:
            with open(path, "rb") as f:
                raw = f.read()
        except OSError:
            raise SetupError("no private term list%s. Set PRIVATE_TERMS, or PRIVATE_TERMS_FILE, or create "
                             "private-terms in your private settings folder (README, Leak check). A scan with "
                             "nothing to look for proves nothing, so this fails." % local(path))
    if raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    terms = []
    for n, line in enumerate(raw.decode("utf-8", "replace").splitlines(), 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        t = norm(line).strip()
        if t:
            terms.append((len(terms) + 1, t))
    if not terms:
        raise SetupError("the private term list is empty%s. A scan with nothing to look for proves "
                         "nothing, so this fails." % local(where))
    return terms


# ---------- git ----------

def git(*args, ok=(0,)):
    p = subprocess.run(["git"] + list(args), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode not in ok:
        raise SetupError("git %s failed" % args[0])
    return p.stdout


class Objects:
    """Raw object access through one `git cat-file --batch` and one --batch-check."""

    def __init__(self):
        self.cat = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.chk = subprocess.Popen(["git", "cat-file", "--batch-check"], stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    @staticmethod
    def _ask(proc, rev):
        if isinstance(rev, str):
            rev = rev.encode("utf-8", "surrogateescape")
        if b"\n" in rev:
            return None
        proc.stdin.write(rev + b"\n")
        proc.stdin.flush()
        head = proc.stdout.readline()
        if not head:
            raise SetupError("git cat-file stopped")
        parts = head.split()
        if len(parts) != 3:          # "<rev> missing" or "<rev> ambiguous"
            return None
        return parts[0].decode(), parts[1].decode(), int(parts[2])

    def info(self, rev):
        """(sha, type) or None."""
        r = self._ask(self.chk, rev)
        return (r[0], r[1]) if r else None

    def read(self, rev):
        """(type, bytes) or None."""
        r = self._ask(self.cat, rev)
        if not r:
            return None
        data = self.cat.stdout.read(r[2])
        self.cat.stdout.read(1)
        return r[1], data

    def close(self):
        for p in (self.cat, self.chk):
            try:
                p.stdin.close()
                p.wait(timeout=5)
            except Exception:
                p.kill()


def parse_raw_diff(out):
    """diff-tree -r -z --raw --no-renames -> {path: (dst mode, dst sha, status)}."""
    res = {}
    parts = out.split(b"\0")
    i = 0
    while i + 1 < len(parts):
        meta, path = parts[i], parts[i + 1]
        i += 2
        if not meta.startswith(b":"):
            raise SetupError("unexpected git diff-tree output")
        f = meta[1:].split(b" ")
        res[path] = (f[1], f[3].decode(), f[4][:1].decode())
    return res


def ls_tree(rev):
    """ls-tree -r -z -> {path: (mode, sha, 'A')}."""
    res = {}
    for rec in git("ls-tree", "-r", "-z", "--full-tree", rev).split(b"\0"):
        if not rec:
            continue
        meta, _, path = rec.partition(b"\t")
        mode, _typ, sha = meta.split(b" ")
        res[path] = (mode, sha.decode(), "A")
    return res


# ---------- scanning ----------

class Scanner:
    def __init__(self, terms):
        self.terms = terms
        self.hits = {}            # (template, name) -> set of term numbers
        self.blobs = {}           # blob sha -> set of term numbers
        self.items = 0
        self._objs = None

    @property
    def objs(self):
        if self._objs is None:
            self._objs = Objects()
        return self._objs

    def match_text(self, s, name=False):
        found = set()
        for t in forms(s, name):
            for i, term in self.terms:
                if term in t:
                    found.add(i)
        return found

    def match_bytes(self, b, name=False):
        found = set()
        for chunk in expand(b):
            for s in decodings(chunk):
                found |= self.match_text(s, name)
        return found

    def add(self, where, found):
        self.items += 1
        if found:
            self.hits.setdefault(where, set()).update(found)

    def scan(self, b, template, name=None, is_name=False):
        """Scan bytes b; on a hit, report template with {} replaced by name."""
        self.add((template, name), self.match_bytes(b, is_name))

    def blob(self, sha):
        if sha not in self.blobs:
            obj = self.objs.read(sha)
            self.blobs[sha] = self.match_bytes(obj[1]) if obj else set()
        return self.blobs[sha]

    # --- commits ---
    def commit(self, sha):
        obj = self.objs.read(sha)
        if not obj or obj[0] != "commit":
            raise SetupError("cannot read commit%s" % local(sha))
        head, _, msg = obj[1].partition(b"\n\n")
        lines = head.split(b"\n")
        short = sha[:12]
        meta = [l for l in lines if not l.startswith((b"tree ", b"parent "))]
        self.scan(b"\n".join(meta), "commit %s author, committer and headers" % short)
        self.scan(msg, "commit %s message" % short)
        for l in lines:
            if l.startswith(b"encoding "):
                try:
                    self.add(("commit %s message" % short, None),
                             self.match_text(msg.decode(l[9:].decode().strip(), "replace")))
                except (LookupError, ValueError):
                    pass
        parents = [l[7:].decode() for l in lines if l.startswith(b"parent ")]
        known = [p for p in parents if (self.objs.info(p) or ("", ""))[1] == "commit"]
        if parents and len(known) == len(parents):
            per = [parse_raw_diff(git("diff-tree", "-r", "-z", "--raw", "--no-renames", "--no-abbrev",
                                      "--ignore-submodules=none", p, sha)) for p in known]
            # A merge publishes only what differs from every parent; the rest is in a parent.
            paths = set(per[0]).intersection(*per[1:]) if len(per) > 1 else set(per[0])
            entries = {p: per[0][p] for p in paths}
        else:
            entries = ls_tree(sha)   # a root commit, or a parent this clone lacks (shallow)
        self.entries(entries, "commit %s" % short)

    def entries(self, entries, prefix):
        for path in sorted(entries):
            mode, bsha, status = entries[path]
            self.scan(path, prefix + " path {}", path, is_name=True)
            if status != "D" and not NULL_SHA.match(bsha) and mode != b"160000":
                self.add((prefix + " file {}", path), self.blob(bsha))

    def commits(self, include, exclude=(), not_refs=()):
        args = ["rev-list"] + list(include) + ["^" + e for e in exclude]
        if not_refs:
            args += ["--not"] + list(not_refs)
        shas = git(*args).split()
        for c in shas:
            self.commit(c.decode())
        return len(shas)

    # --- refs and tags ---
    def target(self, rev, label, tips):
        """Scan annotated tags on the way from rev to what it names; collect commits."""
        info = self.objs.info(rev)
        depth = 0
        while info and info[1] == "tag" and depth < 20:
            obj = self.objs.read(info[0])
            head, _, msg = obj[1].partition(b"\n\n")
            rest = [l for l in head.split(b"\n") if not l.startswith(b"object ")]
            self.scan(b"\n".join(rest) + b"\n\n" + msg, "annotated tag {}", label, )
            nxt = [l[7:].decode() for l in head.split(b"\n") if l.startswith(b"object ")]
            info = self.objs.info(nxt[0]) if nxt else None
            depth += 1
        if not info:
            return
        if info[1] == "commit":
            tips.append(info[0])
        elif info[1] == "tree":
            self.entries(ls_tree(info[0]), "tree %s" % info[0][:12])
        elif info[1] == "blob":
            self.add(("blob %s" % info[0][:12], None), self.blob(info[0]))

    def ref_name(self, name):
        if isinstance(name, str):
            name = name.encode("utf-8", "surrogateescape")
        self.scan(name, "ref name {}", name, is_name=True)

    # --- files outside git objects ---
    def text_env(self, var):
        self.scan(os.environb.get(var.encode(), b""), "$" + var)

    def text_file(self, path):
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            raise SetupError("cannot read --text-file%s" % local(path))
        self.scan(data, "file {}", os.fsencode(path), )

    def worktree(self):
        names = set(git("diff", "-z", "--name-only", "--no-renames", "--no-relative", "HEAD", ok=(0, 128)).split(b"\0"))
        names |= set(git("diff", "-z", "--name-only", "--no-renames", "--no-relative", "--cached", ok=(0, 128)).split(b"\0"))
        names |= set(git("ls-files", "-z", "--others", "--exclude-standard").split(b"\0"))
        for path in sorted(n for n in names if n):
            self.scan(path, "worktree path {}", path, is_name=True)
            try:
                if os.path.islink(path):
                    data = os.readlink(path)
                elif os.path.isfile(path):
                    with open(path, "rb") as f:
                        data = f.read()
                else:
                    continue
            except OSError:
                raise SetupError("cannot read a worktree file")
            self.scan(data, "worktree file {}", path)

    # --- report ---
    def shown(self, template, name):
        if name is None:
            return template
        if self.match_bytes(name, True):
            return template.format("(name withheld: it holds a term)")
        return template.format(name.decode("utf-8", "backslashreplace"))

    def close(self):
        if self._objs:
            self._objs.close()


# ---------- modes ----------

def git_root():
    p = subprocess.run(["git", "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SetupError("not inside a git repository")
    os.chdir(p.stdout.rstrip(b"\n"))


def commit_sha(sc, rev, what):
    info = sc.objs.info(rev + "^{commit}")
    if not info:
        raise SetupError("%s is not a commit in this clone (fetch it first)%s" % (what, local(rev)))
    return info[0]


def mode_range(sc, base, head):
    h = commit_sha(sc, head, "--range HEAD")
    if NULL_SHA.match(base):      # no base (a new branch): everything reachable
        return sc.commits([h])
    return sc.commits([h], [commit_sha(sc, base, "--range BASE")])


def mode_pre_push(sc, remote, stdin):
    remotes = git("remote").decode("utf-8", "replace").split()
    # Commits already on that remote's tracking refs are public; everything else is scanned.
    not_refs = ["--remotes=" + remote] if remote in remotes else []
    tips, exclude = [], []
    for line in stdin.split(b"\n"):
        parts = line.split(b" ")
        if len(parts) != 4:
            continue
        local_ref, local_sha, remote_ref, remote_sha = parts
        sc.ref_name(local_ref)
        sc.ref_name(remote_ref)
        if NULL_SHA.match(local_sha.decode()):
            continue                   # a delete publishes nothing new
        if not NULL_SHA.match(remote_sha.decode()) and sc.objs.info(remote_sha):
            exclude.append(remote_sha.decode())
        sc.target(local_sha, remote_ref, tips)
    n = sc.commits(tips, [e for e in exclude if (sc.objs.info(e) or ("", ""))[1] == "commit"], not_refs) if tips else 0
    return n


def mode_all(sc):
    refs = [r for r in git("for-each-ref", "--format=%(refname)%00").split(b"\0") if r.strip()]
    tips = []
    for r in refs:
        r = r.strip(b"\n")
        sc.ref_name(r)
        sc.target(r, r, tips)
    if sc.objs.info("HEAD"):
        tips.append(commit_sha(sc, "HEAD", "HEAD"))
        sc.entries(ls_tree("HEAD"), "HEAD")
    return sc.commits(tips) if tips else 0


def parse(argv):
    o = {"range": None, "pre_push": None, "all": False, "worktree": False, "refs": [], "envs": [], "files": []}
    it = iter(argv)

    def need(flag):
        try:
            return next(it)
        except StopIteration:
            raise SetupError("%s needs a value" % flag)
    for a in it:
        flag, eq, val = a.partition("=")
        if a in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        elif a == "--range":
            o["range"] = (need(a), need(a))
        elif a == "--pre-push":
            o["pre_push"] = need(a)
            o["pre_push_url"] = None
        elif a == "--all":
            o["all"] = True
        elif a == "--worktree":
            o["worktree"] = True
        elif flag in ("--ref-name", "--text-env", "--text-file"):
            v = val if eq else need(flag)
            o[{"--ref-name": "refs", "--text-env": "envs", "--text-file": "files"}[flag]].append(v)
        elif o.get("pre_push_url", 0) is None and not a.startswith("-"):
            o["pre_push_url"] = a     # git passes the remote's URL as the hook's second argument
        else:
            raise SetupError("unknown argument%s; see --help" % local(a))
    modes = sum([o["range"] is not None, o["pre_push"] is not None, o["all"]])
    if modes > 1:
        raise SetupError("--range, --pre-push and --all are exclusive")
    if not modes and not (o["refs"] or o["envs"] or o["files"] or o["worktree"]):
        raise SetupError("nothing to scan; see --help")
    return o


def main(argv):
    o = parse(argv)
    terms = load_terms()
    sc = Scanner(terms)
    scope = []
    try:
        if o["range"] or o["pre_push"] or o["all"] or o["worktree"]:
            git_root()
        if o["range"]:
            n = mode_range(sc, *o["range"])
            scope.append("%d commit(s) in the range" % n)
        if o["pre_push"]:
            n = mode_pre_push(sc, o["pre_push"], sys.stdin.buffer.read())
            scope.append("%d commit(s) to push, with ref names and tags" % n)
        if o["all"]:
            n = mode_all(sc)
            scope.append("every ref, tag and commit (%d), and HEAD's tree" % n)
        for r in o["refs"]:
            sc.ref_name(r)
        for v in o["envs"]:
            sc.text_env(v)
        for f in o["files"]:
            sc.text_file(f)
        if o["worktree"]:
            sc.worktree()
            scope.append("uncommitted and untracked files")
        extra = len(o["refs"]) + len(o["envs"]) + len(o["files"])
        if extra:
            scope.append("%d name(s) and text(s)" % extra)
        if sc.hits:
            if CI:
                print("leak-check: FAIL")
                return 1
            shown = {}
            for (template, name), found in sc.hits.items():
                shown.setdefault(sc.shown(template, name), set()).update(found)
            print("leak-check: FAIL, private terms found (%d location(s), of %d terms):" % (len(shown), len(terms)))
            for i, (where, found) in enumerate(shown.items()):
                if i == 200:
                    print("  ... and %d more" % (len(shown) - 200))
                    break
                print("  term #%s in %s" % (", #".join(str(t) for t in sorted(found)), where))
            print("Term numbers are positions in your private list; the terms are never printed.")
            return 1
        if CI:
            print("leak-check: clean")
        else:
            print("leak-check: clean (%d terms; %s)" % (len(terms), "; ".join(scope)))
        return 0
    finally:
        sc.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SetupError as e:
        print("leak-check: error: %s" % e, file=sys.stderr)
        sys.exit(2)
    except Exception as e:  # never let a traceback print data
        if not CI and os.environ.get("LEAK_CHECK_DEBUG") == "1":
            raise
        print("leak-check: error: %s%s" % ("internal error", local(type(e).__name__)), file=sys.stderr)
        sys.exit(2)
