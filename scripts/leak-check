#!/usr/bin/env python3
"""Fail if a private term appears in anything this public repo would publish.

  python3 -I scripts/leak-check --range BASE HEAD    every commit in BASE..HEAD
  python3 -I scripts/leak-check --pre-push REMOTE URL      git's pre-push stdin
  python3 -I scripts/leak-check --github-event     CI: reads $GITHUB_EVENT_PATH
  python3 -I scripts/leak-check --all                every ref, tag and commit
  python3 -I scripts/leak-check --text-env VAR | --text-file PATH
Add to any mode: --ref-name NAME, --text-env VAR, --text-file PATH (repeatable),
and --worktree (uncommitted and untracked files).

For each commit it scans the raw commit object (author, committer, message and
other headers), the full new content of every file the commit adds or
modifies, every path (directories included) it adds, deletes or renames, and
symlink targets. Content is raw blob bytes: .gitattributes, textconv, filters
and replace refs are ignored (a repo with refs/replace/* or grafts is
refused); UTF-8, cp1252, UTF-16 and UTF-32 are tried, and zip, gzip, zlib,
bzip2 and xz content is opened. --pre-push also scans pushed ref names and
annotated tags, and counts as already public only what the destination itself
advertises. Its URL argument is mandatory: git always passes REMOTE and URL to
the pre-push hook, and the word after REMOTE is taken as URL even if it looks
like a flag, so run by hand it must be given both. --github-event scans a pull_request_target PR's commits, head
branch, title and body, or a push's before..after, and fails a PR from a fork
without scanning it. A pull_request event is refused (exit 2) under
GITHUB_ACTIONS=true, since that run uses the PR's own scanner and cannot gate;
locally it is scanned like pull_request_target. Every mode but --pre-push
claims the whole history it names, so it is refused (exit 2) in a shallow
clone whose edge the walk reaches; fetch full history.

Terms come from $PRIVATE_TERMS (newline-separated) when it is set, else from
the file $PRIVATE_TERMS_FILE, default ${SKILLZ_CONTEXT:-~/.config/skillz}/
private-terms. Blank lines and # comments are skipped; write \\# for a term
that starts with #. Terms and text are normalized alike (NFKC, casefold,
invisible characters removed, whitespace runs collapsed to one space) and each
item (a file, a message, a name) is matched whole. Further forms undo HTML
comments, tags and entities, JSON/JS escapes, %-escapes and Markdown emphasis.
In names and identities, - _ / . and Unicode dashes also count as a space.

Commit messages and PR text holding a CI skip instruction ([skip ci] and the
like) fail too, so the CI backstop cannot be silenced.

Output never contains a term or echoes an argument. Locally it names each
hit's location and the term's number (a name that holds a term is withheld).
With GITHUB_ACTIONS=true it prints only a fixed FAIL line or
"leak-check: clean".

Exit: 0 clean, 1 a term matched (or a skip instruction, or a fork PR),
2 usage or setup error (no terms included).
"""
import html
import io
import json
import os
import re
import subprocess
import sys
import unicodedata
import urllib.parse
import zipfile
import zlib

try:
    import bz2
except ImportError:  # pragma: no cover
    bz2 = None
try:
    import lzma
except ImportError:  # pragma: no cover
    lzma = None

# Push sends the original objects, so never read replacements.
os.environ["GIT_NO_REPLACE_OBJECTS"] = "1"
os.environ["GIT_TERMINAL_PROMPT"] = "0"

CI = os.environ.get("GITHUB_ACTIONS") == "true"
NULL_SHA = re.compile(r"\A0+\Z")
MAX_INFLATE = 32 << 20          # per compressed member or stream
MAX_INFLATE_TOTAL = 128 << 20   # per container
MAX_ZLIB_TRIES = 256
WITHHELD = "(name withheld: it holds a term)"


class SetupError(Exception):
    pass


def warn(msg):
    if not CI:
        print("leak-check: warning: " + msg, file=sys.stderr)


# ---------- normalization ----------

def _ignorable():
    cps = [0x0000, 0xFFFD, 0x034F, 0x115F, 0x1160, 0x3164, 0xFFA0]
    cps += list(range(0x180B, 0x1810)) + list(range(0xFE00, 0xFE10)) + list(range(0xE0100, 0xE01F0))
    for rng in (range(0, 0x20000), range(0xE0000, 0xE1000)):
        cps += [cp for cp in rng if unicodedata.category(chr(cp)) == "Cf"]
    return dict.fromkeys(cps)


IGNORABLE = _ignorable()  # every format char (zero-width, bidi, soft hyphen, BOM), NUL, U+FFFD
WS = re.compile(r"\s+")
COMMENT = re.compile(r"<!--.*?(?:-->|\Z)", re.S)
TAG = re.compile(r"<[^<>]*>")
MARKDOWN = re.compile(r"[*_~`\\]")
NAME_SEP = re.compile("[-_/.\\\\\u2010-\u2015\u2212]+")
JS_U4 = re.compile(r"(?:\\u[0-9a-fA-F]{4})+")
JS_UB = re.compile(r"\\u\{([0-9a-fA-F]{1,6})\}")
JS_X = re.compile(r"(?:\\x[0-9a-fA-F]{2})+")
JS_WS = re.compile(r"\\[nrtfv]")
SKIP_CI = re.compile(r"\[ ?(?:skip ci|ci skip|no ci|skip actions|actions skip) ?\]|skip-checks ?: ?true")


def norm(s):
    s = unicodedata.normalize("NFKC", s.translate(IGNORABLE)).casefold()
    s = unicodedata.normalize("NFKC", s).translate(IGNORABLE)
    return WS.sub(" ", s)


def sep(s):
    """A normalized name with separators read as spaces: a-b, a_b and A/B read as "a b"."""
    return WS.sub(" ", NAME_SEP.sub(" ", s)).strip()


def _xbytes(m):
    b = bytes.fromhex(m.group(0).replace("\\x", ""))
    try:
        return b.decode("utf-8")
    except UnicodeDecodeError:
        return b.decode("latin-1")


def _ub(m):
    cp = int(m.group(1), 16)
    return chr(cp) if cp <= 0x10FFFF else ""


def unescape(s, tag=""):
    """Undo what GitHub would render away or a reader would decode: markup, entities, escapes."""
    t = COMMENT.sub("", s) if "<!--" in s else s
    if "<" in t:
        t = TAG.sub(tag, t)
    if "&" in t:
        t = html.unescape(t)
    if "\\" in t:
        t = JS_U4.sub(lambda m: bytes.fromhex(m.group(0).replace("\\u", "")).decode("utf-16-be", "replace"), t)
        t = JS_UB.sub(_ub, t)
        t = JS_X.sub(_xbytes, t)
        t = JS_WS.sub(" ", t)
    if "%" in t or "+" in t:
        t = urllib.parse.unquote_plus(t)
        if "&" in t:
            t = html.unescape(t)
    return t


def forms(s):
    out = [s]
    for tag in ("", " "):
        u = unescape(s, tag)
        if u != s:
            out.append(u)
        if "<" not in s:
            break
    for t in list(out):
        if MARKDOWN.search(t):  # a**b**c renders as one word, abc
            out.append(MARKDOWN.sub("", t))
    return {norm(t) for t in out}


def decodings(b):
    out = []
    try:
        out.append(b.decode("utf-8"))
    except UnicodeDecodeError:
        out += [b.decode("utf-8", "replace"), b.decode("cp1252", "replace")]
    if b"\x00" in b or b[:2] in (b"\xff\xfe", b"\xfe\xff"):
        for enc in ("utf-16-le", "utf-16-be"):
            out += [b[off:].decode(enc, "replace") for off in (0, 1)]
        if b"\x00\x00\x00" in b or b[:4] in (b"\xff\xfe\x00\x00", b"\x00\x00\xfe\xff"):
            for enc in ("utf-32-le", "utf-32-be"):
                out += [b[off:].decode(enc, "replace") for off in range(4)]
    return out


# ---------- containers and compression ----------

def _gzip_members(b):
    """Every member of a (multi-member) gzip stream, bounded."""
    total = 0
    while b[:2] == b"\x1f\x8b" and total < MAX_INFLATE_TOTAL:
        d = zlib.decompressobj(16 + zlib.MAX_WBITS)
        try:
            out = d.decompress(b, MAX_INFLATE)
        except zlib.error:
            return
        total += len(out)
        yield out
        b = d.unused_data
        if d.unconsumed_tail:  # member exceeded the bound; stop here
            return


def _zlib_streams(b):
    """Raw zlib streams inside the content (PDF FlateDecode, say), bounded."""
    total, tries = 0, 0
    for m in re.finditer(rb"\x78[\x01\x5e\x9c\xda]", b):
        tries += 1
        if tries > MAX_ZLIB_TRIES or total > MAX_INFLATE_TOTAL:
            return
        try:
            out = zlib.decompressobj().decompress(b[m.start():], MAX_INFLATE)
        except zlib.error:
            continue
        if out:
            total += len(out)
            yield out


def _other_streams(b):
    if bz2 and b[:3] == b"BZh":
        try:
            yield bz2.BZ2Decompressor().decompress(b, MAX_INFLATE)
        except Exception:
            pass
    if lzma and (b[:6] == b"\xfd7zXZ\x00" or b[:3] == b"\x5d\x00\x00"):
        try:
            yield lzma.LZMADecompressor(lzma.FORMAT_AUTO).decompress(b, MAX_INFLATE)
        except Exception:
            pass


def expand(b, depth=0):
    """b itself, then what compressed or archived content inside it holds (bounded)."""
    yield b
    if depth >= 3:
        return
    inner = []
    if b[:2] == b"\x1f\x8b":
        inner += list(_gzip_members(b))
    else:
        inner += list(_zlib_streams(b))
    inner += list(_other_streams(b))
    if b"PK\x05\x06" in b[-65557:]:
        try:
            with zipfile.ZipFile(io.BytesIO(b)) as z:
                total = 0
                for info in z.infolist()[:10000]:
                    yield info.filename.encode("utf-8", "surrogateescape")
                    if info.is_dir() or info.file_size > MAX_INFLATE or total > MAX_INFLATE_TOTAL:
                        continue
                    try:
                        data = z.read(info)
                    except Exception:
                        continue
                    total += len(data)
                    inner.append(data)
        except Exception:
            pass
    for x in inner:
        for y in expand(x, depth + 1):
            yield y


# ---------- terms ----------

def load_terms():
    if "PRIVATE_TERMS" in os.environ:
        raw = os.environb.get(b"PRIVATE_TERMS", b"")
    else:
        ctx = os.environ.get("SKILLZ_CONTEXT") or os.path.expanduser("~/.config/skillz")
        path = os.environ.get("PRIVATE_TERMS_FILE") or os.path.join(ctx, "private-terms")
        try:
            with open(path, "rb") as f:
                raw = f.read()
        except OSError:
            raise SetupError("no private term list. Set PRIVATE_TERMS, or PRIVATE_TERMS_FILE, or create "
                             "private-terms in your private settings folder (docs/leak-check.md). A scan with "
                             "nothing to look for proves nothing, so this fails.")
    if raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    terms = []
    for n, line in enumerate(raw.decode("utf-8", "replace").splitlines(), 1):
        line = line.strip()
        if not line:
            continue
        if line.startswith("#"):
            if re.match(r"#\w", line):
                warn("line %d of the term list is read as a comment but looks like a term; "
                     "write \\# at its start to make it one" % n)
            continue
        if line.startswith("\\#"):
            line = line[1:]
        t = norm(line).strip()
        if t:
            terms.append((len(terms) + 1, t, sep(t)))
    if not terms:
        raise SetupError("the private term list is empty. A scan with nothing to look for proves "
                         "nothing, so this fails.")
    return terms


# ---------- git ----------

def git(*args, ok=(0,)):
    p = subprocess.run(["git"] + list(args), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode not in ok:
        raise SetupError("git %s failed" % args[0])
    return p.stdout


def git_path(name):
    """Path of name in the git dir. git before 2.5 has no --git-path and echoes it
    back (exit 0), which would name a file that never exists; refuse that."""
    out = git("rev-parse", "--git-path", name).rstrip(b"\n")
    if not out or b"\n" in out or out.startswith(b"-"):
        raise SetupError("cannot resolve the git directory (git 2.5 or newer is needed)")
    return out


class Objects:
    """Raw object access through one `git cat-file --batch` and one --batch-check."""

    def __init__(self):
        self.cat = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        self.chk = subprocess.Popen(["git", "cat-file", "--batch-check"], stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)

    @staticmethod
    def _ask(proc, rev):
        if isinstance(rev, str):
            rev = rev.encode("utf-8", "surrogateescape")
        if b"\n" in rev or not rev:
            return None
        proc.stdin.write(rev + b"\n")
        proc.stdin.flush()
        head = proc.stdout.readline()
        if not head:
            raise SetupError("git cat-file stopped")
        parts = head.split()
        if len(parts) != 3:          # "<rev> missing" or "<rev> ambiguous"
            return None
        return parts[0].decode(), parts[1].decode(), int(parts[2])

    def info(self, rev):
        """(sha, type) or None."""
        r = self._ask(self.chk, rev)
        return (r[0], r[1]) if r else None

    def kind(self, rev):
        r = self.info(rev)
        return r[1] if r else None

    def read(self, rev):
        """(type, bytes) or None."""
        r = self._ask(self.cat, rev)
        if not r:
            return None
        data = self.cat.stdout.read(r[2])
        self.cat.stdout.read(1)
        return r[1], data

    def close(self):
        for p in (self.cat, self.chk):
            try:
                p.stdin.close()
                p.wait(timeout=5)
            except Exception:
                p.kill()


def parse_raw_diff(out):
    """diff-tree -t -z --raw --no-renames -> {path: (dst mode, dst sha, status)}."""
    res = {}
    parts = out.split(b"\0")
    i = 0
    while i + 1 < len(parts):
        meta, path = parts[i], parts[i + 1]
        i += 2
        if not meta.startswith(b":"):
            raise SetupError("unexpected git diff-tree output")
        f = meta[1:].split(b" ")
        res[path] = (f[1], f[3].decode(), f[4][:1].decode())
    return res


def ls_tree(rev):
    """ls-tree -r -t -z -> {path: (mode, sha, 'A')}, directories included."""
    res = {}
    for rec in git("ls-tree", "-r", "-t", "-z", "--full-tree", rev).split(b"\0"):
        if not rec:
            continue
        meta, _, path = rec.partition(b"\t")
        mode, _typ, sha = meta.split(b" ")
        res[path] = (mode, sha.decode(), "A")
    return res


def refuse_replacements():
    if git("for-each-ref", "--format=%(refname)", "refs/replace/").strip():
        raise SetupError("this repo has refs/replace/*: a push sends the originals, so a scan through "
                         "replacements proves nothing. Remove them (git replace -d) and rerun.")
    if os.path.exists(git_path("info/grafts")):
        raise SetupError("this repo has an info/grafts file; remove it and rerun.")


# ---------- scanning ----------

def refuse_shallow_edge(shas):
    """A walk that reaches a shallow clone's edge misses every commit past it.
    A clone is shallow exactly when its git dir holds a shallow file; that test
    works on every git (rev-parse --is-shallow-repository needs 2.15 and older
    git echoes it back with exit 0)."""
    shallow = git_path("shallow")
    if not os.path.lexists(shallow):
        return
    try:
        with open(shallow, "rb") as f:
            edge = set(f.read().split())
    except OSError:
        raise SetupError("this clone is shallow and its shallow list is unreadable; fetch full history")
    if edge.intersection(shas):
        raise SetupError("this clone is shallow and the scan reaches its edge, so older commits "
                         "would go unscanned; fetch full history (git fetch --unshallow)")


SURROGATE = re.compile("[\ud800-\udfff]")


def text_bytes(s):
    """JSON text -> bytes for scanning. Each lone surrogate (JSON allows one)
    becomes U+FFFD, which norm drops, so the text around it is still scanned
    and no two of them can pair into a character that would hide a term (a
    combining mark that NFKC folds into the term's last letter, say)."""
    return SURROGATE.sub("\ufffd", s).encode("utf-8")


class Scanner:
    def __init__(self, terms):
        self.terms = terms
        self.hits = {}            # (template, name) -> set of term numbers
        self.skips = []           # locations holding a CI skip instruction
        self.blobs = {}           # blob sha -> set of term numbers
        self.fork = False
        self._objs = None

    @property
    def objs(self):
        if self._objs is None:
            self._objs = Objects()
        return self._objs

    def match_text(self, s, name=False):
        found = set()
        fs = forms(s)
        for t in fs:
            for i, term, _ in self.terms:
                if term in t:
                    found.add(i)
        if name:
            for t in {sep(x) for x in fs}:
                for i, _, term in self.terms:
                    if term and term in t:
                        found.add(i)
        return found

    def match_bytes(self, b, name=False):
        found = set()
        for chunk in expand(b):
            for s in decodings(chunk):
                found |= self.match_text(s, name)
        return found

    def add(self, where, found):
        if found:
            self.hits.setdefault(where, set()).update(found)

    def scan(self, b, template, name=None, is_name=False):
        """Scan bytes b; on a hit, report template with {} replaced by name."""
        self.add((template, name), self.match_bytes(b, is_name))

    def message(self, b, template, name=None):
        """A commit or tag message, or PR text: terms, and CI skip instructions."""
        self.scan(b, template, name)
        if any(SKIP_CI.search(norm(s)) for s in decodings(b)[:2]):
            self.skips.append((template, name))

    def blob(self, sha):
        if sha not in self.blobs:
            # A blob this clone lacks and cannot fetch (a partial clone whose promisor
            # fetch fails or is disabled, a missing object) is unread, never clean.
            err = "cannot read blob %s; fetch it or use a full clone" % sha
            try:
                obj = self.objs.read(sha)
            except SetupError:
                raise SetupError(err)    # cat-file died, e.g. on a failed promisor fetch
            if not obj:
                raise SetupError(err)
            self.blobs[sha] = self.match_bytes(obj[1])
        return self.blobs[sha]

    # --- commits ---
    def commit(self, sha):
        obj = self.objs.read(sha)
        if not obj or obj[0] != "commit":
            raise SetupError("cannot read a commit")
        head, _, msg = obj[1].partition(b"\n\n")
        lines = head.split(b"\n")
        short = sha[:12]
        meta = [l for l in lines if not l.startswith((b"tree ", b"parent "))]
        self.scan(b"\n".join(meta), "commit %s author, committer and headers" % short, is_name=True)
        self.message(msg, "commit %s message" % short)
        for l in lines:
            if l.startswith(b"encoding "):
                try:
                    self.add(("commit %s message" % short, None),
                             self.match_text(msg.decode(l[9:].decode().strip(), "replace")))
                except (LookupError, ValueError):
                    pass
        parents = [l[7:].decode() for l in lines if l.startswith(b"parent ")]
        known = [p for p in parents if self.objs.kind(p) == "commit"]
        if parents and len(known) == len(parents):
            per = [parse_raw_diff(git("diff-tree", "-t", "-z", "--raw", "--no-renames", "--no-abbrev",
                                      "--ignore-submodules=none", p, sha)) for p in known]
            # A merge publishes only what differs from every parent; the rest is in a parent.
            paths = set(per[0]).intersection(*per[1:]) if len(per) > 1 else set(per[0])
            entries = {p: per[0][p] for p in paths}
        else:
            entries = ls_tree(sha)   # a root commit, or a parent this clone lacks (shallow)
        self.entries(entries, "commit %s" % short)

    def entries(self, entries, prefix):
        for path in sorted(entries):
            mode, bsha, status = entries[path]
            self.scan(path, prefix + " path {}", path, is_name=True)
            if status != "D" and not NULL_SHA.match(bsha) and mode not in (b"160000", b"040000"):
                self.add((prefix + " file {}", path), self.blob(bsha))

    def commits(self, include, exclude=(), complete=True):
        """Scan include minus exclude. complete: the caller claims all of that history
        (not just what this clone holds), so a walk that reaches a shallow edge fails."""
        if not include:
            return 0
        revs = list(include) + ["^" + e for e in exclude]
        p = subprocess.run(["git", "rev-list", "--stdin"], input="\n".join(revs).encode() + b"\n",
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if p.returncode != 0:
            raise SetupError("git rev-list failed")
        shas = p.stdout.split()
        if complete:
            refuse_shallow_edge(shas)
        for c in shas:
            self.commit(c.decode())
        return len(shas)

    # --- refs and tags ---
    def target(self, rev, label, tips):
        """Scan annotated tags on the way from rev to what it names; collect commits."""
        info = self.objs.info(rev)
        depth = 0
        while info and info[1] == "tag" and depth < 20:
            obj = self.objs.read(info[0])
            head, _, msg = obj[1].partition(b"\n\n")
            rest = [l for l in head.split(b"\n") if not l.startswith(b"object ")]
            self.scan(b"\n".join(rest), "annotated tag {} header", label, is_name=True)
            self.message(msg, "annotated tag {} message", label)
            nxt = [l[7:].decode() for l in head.split(b"\n") if l.startswith(b"object ")]
            info = self.objs.info(nxt[0]) if nxt else None
            depth += 1
        if not info:
            return
        if info[1] == "commit":
            tips.append(info[0])
        elif info[1] == "tree":
            self.entries(ls_tree(info[0]), "tree %s" % info[0][:12])
        elif info[1] == "blob":
            self.add(("blob %s" % info[0][:12], None), self.blob(info[0]))

    def ref_name(self, name, label="ref name {}"):
        if isinstance(name, str):
            name = text_bytes(name)
        self.scan(name, label, name, is_name=True)

    # --- text outside git objects ---
    def text_env(self, var):
        self.message(os.environb.get(var.encode(), b""), "$" + var)

    def text_file(self, path):
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            raise SetupError("cannot read a --text-file")
        self.scan(data, "file {}", os.fsencode(path))

    def worktree(self):
        names = set(git("diff", "-z", "--name-only", "--no-renames", "--no-relative", "HEAD", ok=(0, 128)).split(b"\0"))
        names |= set(git("diff", "-z", "--name-only", "--no-renames", "--no-relative", "--cached", ok=(0, 128)).split(b"\0"))
        names |= set(git("ls-files", "-z", "--others", "--exclude-standard").split(b"\0"))
        for path in sorted(n for n in names if n):
            self.scan(path, "worktree path {}", path, is_name=True)
            try:
                if os.path.islink(path):
                    data = os.readlink(path)
                elif os.path.isfile(path):
                    with open(path, "rb") as f:
                        data = f.read()
                else:
                    continue
            except OSError:
                raise SetupError("cannot read a worktree file")
            self.scan(data, "worktree file {}", path)

    # --- report ---
    def shown(self, where):
        if isinstance(where, tuple):
            template, name = where
        else:
            template, name = where, None
        if name is None:
            return template
        if self.match_bytes(name, True):
            return template.format(WITHHELD)
        return template.format(name.decode("utf-8", "backslashreplace"))

    def close(self):
        if self._objs:
            self._objs.close()


# ---------- modes ----------

def git_root():
    p = subprocess.run(["git", "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if p.returncode != 0:
        raise SetupError("not inside a git repository")
    os.chdir(p.stdout.rstrip(b"\n"))
    refuse_replacements()


def commit_sha(sc, rev, what):
    info = sc.objs.info(rev + "^{commit}")
    if not info:
        raise SetupError("%s is not a commit in this clone (fetch it first)" % what)
    return info[0]


def mode_range(sc, base, head):
    h = commit_sha(sc, head, "the range's head")
    if NULL_SHA.match(base):      # no base (a new branch): everything reachable
        return sc.commits([h])
    return sc.commits([h], [commit_sha(sc, base, "the range's base")])


def _same_url(a, b):
    def n(u):
        u = u.strip().rstrip("/")
        return u[:-4] if u.endswith(".git") else u
    return n(a) == n(b)


def published_tips(sc, url):
    """Commits the push destination already has, as far as this clone can tell."""
    if url and not url.startswith("-"):
        try:
            p = subprocess.run(["git", "ls-remote", url], stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, timeout=60)
            if p.returncode == 0:
                shas = {l.split(b"\t")[0].decode() for l in p.stdout.splitlines() if b"\t" in l}
                return [s for s in shas if sc.objs.kind(s) in ("commit", "tag")]
        except (subprocess.TimeoutExpired, OSError):
            pass
        # ls-remote failed. Count a tracking ref only when its remote's fetch URL is
        # this push URL and FETCH_HEAD confirms git fetched that commit from this URL;
        # anything unconfirmed is scanned (fail closed).
        fetched = set()
        try:
            with open(git_path("FETCH_HEAD"), "rb") as f:
                for line in f.read().decode("utf-8", "replace").splitlines():
                    parts = line.split("\t")
                    if len(parts) >= 3 and " of " in parts[-1] and _same_url(parts[-1].rsplit(" of ", 1)[1], url):
                        fetched.add(parts[0])
        except OSError:
            pass
        tips = []
        for name in git("remote").decode("utf-8", "replace").split():
            urls = git("config", "--get-all", "remote.%s.url" % name, ok=(0, 1)).decode("utf-8", "replace").split()
            fetch_url = git("remote", "get-url", name, ok=(0, 2, 128)).decode("utf-8", "replace").strip()
            if len(urls) != 1 or not (_same_url(fetch_url, url) or _same_url(urls[0], url)):
                continue
            out = git("for-each-ref", "--format=%(objectname)", "refs/remotes/%s/" % name).decode().split()
            tips += [t for t in out if t in fetched]
        return tips
    return []                         # unknown destination: scan the whole pushed history


def mode_pre_push(sc, url, stdin):
    tips, exclude = [], []
    for line in stdin.split(b"\n"):
        parts = line.split(b" ")
        if len(parts) != 4:
            continue
        local_ref, local_sha, remote_ref, remote_sha = parts
        if NULL_SHA.match(local_sha.decode()):
            continue   # a delete publishes nothing, and is how a leaked name is cleaned up
        # Only the remote ref name is sent; the local one never leaves this clone.
        sc.ref_name(remote_ref)
        if not NULL_SHA.match(remote_sha.decode()) and sc.objs.kind(remote_sha) in ("commit", "tag"):
            exclude.append(remote_sha.decode())
        sc.target(local_sha, remote_ref, tips)
    if not tips:
        return 0
    # complete=False: commits past a shallow edge are not in this clone, so this push cannot send them.
    return sc.commits(tips, exclude + published_tips(sc, url), complete=False)


def mode_github_event(sc):
    path = os.environ.get("GITHUB_EVENT_PATH")
    name = os.environ.get("GITHUB_EVENT_NAME")
    try:
        with open(path or "", "rb") as f:
            ev = json.load(f)
    except (OSError, ValueError):
        raise SetupError("--github-event needs a readable $GITHUB_EVENT_PATH")
    if name == "pull_request" and CI:
        # A pull_request run executes the PR's own copy of this scanner and workflow,
        # so the PR decides the result: it cannot gate. Locally it is a dry run.
        raise SetupError("a pull_request run executes the PR's own scanner, so it cannot gate; "
                         "run --github-event from a pull_request_target workflow")
    if name in ("pull_request_target", "pull_request"):
        pr = ev.get("pull_request") or {}
        head = pr.get("head") or {}
        repo = (ev.get("repository") or {}).get("full_name")
        if not repo or (head.get("repo") or {}).get("full_name") != repo:
            sc.fork = True             # never scan (or answer about) an outside PR
            return "a PR from outside the repo, not scanned"
        # pull_request_target: GITHUB_SHA is the base branch tip. pull_request: it is the
        # merge commit, which holds the PR head, so it would empty the range; use base.sha.
        base = (pr.get("base") or {}).get("sha") or ""
        if name == "pull_request_target":
            base = os.environ.get("GITHUB_SHA") or base
        n = mode_range(sc, base, head.get("sha") or "")
        sc.ref_name("refs/heads/" + (head.get("ref") or ""), "PR head branch {}")
        sc.message(text_bytes(pr.get("title") or ""), "PR title")
        sc.message(text_bytes(pr.get("body") or ""), "PR body")
        return "%d PR commit(s), head branch, title and body" % n
    if name == "push":
        after = ev.get("after") or ""
        if NULL_SHA.match(after) or not after:
            return "a branch delete, nothing to scan"
        before = ev.get("before") or "0"
        if not NULL_SHA.match(before) and not sc.objs.info(before + "^{commit}"):
            # A force-push (say, purging a leaked commit) leaves before out of the
            # clone: scan all of after's history instead, a superset of what is new
            # (commits() refuses it in a shallow clone, which lacks that history too).
            warn("the push's before commit is not in this clone; scanning all of after's history")
            before = "0"
        n = mode_range(sc, before, after)
        return "%d pushed commit(s)" % n
    raise SetupError("--github-event supports pull_request_target, pull_request and push events only")


def parse(argv):
    o = {"range": None, "pre_push": None, "url": None, "event": False, "all": False, "worktree": False,
         "refs": [], "envs": [], "files": []}
    args = list(argv)

    def need(flag):
        if not args:
            raise SetupError("%s needs a value" % flag)
        return args.pop(0)
    while args:
        a = args.pop(0)
        flag, eq, val = a.partition("=")
        if a in ("-h", "--help"):
            if len(argv) != 1:   # only a bare --help exits 0; with other args it is an error
                raise SetupError("--help takes no other arguments")
            print(__doc__)
            sys.exit(0)
        elif a == "--range":
            o["range"] = (need(a), need(a))
        elif a == "--pre-push":
            o["pre_push"] = need(a)
            # git passes the destination URL as the hook's second argument. Always take it,
            # even if it looks like a flag: a remote URL of "--help" must not print help.
            # The URL is mandatory (see the docstring); git always supplies it to the hook.
            o["url"] = args.pop(0) if args else ""
        elif a == "--github-event":
            o["event"] = True
        elif a == "--all":
            o["all"] = True
        elif a == "--worktree":
            o["worktree"] = True
        elif flag in ("--ref-name", "--text-env", "--text-file"):
            v = val if eq else need(flag)
            o[{"--ref-name": "refs", "--text-env": "envs", "--text-file": "files"}[flag]].append(v)
        else:
            raise SetupError("unknown argument; see --help")
    modes = sum([o["range"] is not None, o["pre_push"] is not None, o["all"], o["event"]])
    if modes > 1:
        raise SetupError("--range, --pre-push, --github-event and --all are exclusive")
    if not modes and not (o["refs"] or o["envs"] or o["files"] or o["worktree"]):
        raise SetupError("nothing to scan; see --help")
    return o


def report(sc, terms, scope):
    if CI:
        if sc.fork:
            print("leak-check: fork PRs are not scanned; a maintainer must re-open this from a branch in the repo")
        elif sc.skips:
            print("leak-check: FAIL: a commit message or the PR text holds a CI skip instruction")
        elif sc.hits:
            print("leak-check: FAIL")
        else:
            print("leak-check: clean")
        return 1 if (sc.fork or sc.skips or sc.hits) else 0
    if sc.fork:
        print("leak-check: fork PRs are not scanned; a maintainer must re-open this from a branch in the repo")
        return 1
    if not sc.hits and not sc.skips:
        print("leak-check: clean (%d terms; %s)" % (len(terms), "; ".join(scope)))
        return 0
    if sc.skips:
        print("leak-check: FAIL, CI skip instruction ([skip ci] or similar) in:")
        for w in dict.fromkeys(sc.shown(w) for w in sc.skips):
            print("  " + w)
    if sc.hits:
        shown = {}
        for where, found in sc.hits.items():
            shown.setdefault(sc.shown(where), set()).update(found)
        print("leak-check: FAIL, private terms found (%d location(s), of %d terms):" % (len(shown), len(terms)))
        for i, (where, found) in enumerate(shown.items()):
            if i == 200:
                print("  ... and %d more" % (len(shown) - 200))
                break
            print("  term #%s in %s" % (", #".join(str(t) for t in sorted(found)), where))
        print("Term numbers are positions in your private list; the terms are never printed.")
    return 1


def main(argv):
    o = parse(argv)
    terms = load_terms()
    sc = Scanner(terms)
    scope = []
    try:
        if o["range"] or o["pre_push"] or o["all"] or o["worktree"] or o["event"]:
            git_root()
        if o["range"]:
            scope.append("%d commit(s) in the range" % mode_range(sc, *o["range"]))
        if o["pre_push"]:
            n = mode_pre_push(sc, o["url"], sys.stdin.buffer.read())
            scope.append("%d commit(s) to push, with ref names and tags" % n)
        if o["event"]:
            scope.append(mode_github_event(sc))
        if o["all"]:
            refs = [r.strip(b"\n") for r in git("for-each-ref", "--format=%(refname)%00").split(b"\0") if r.strip()]
            tips = []
            for r in refs:
                sc.ref_name(r)
                sc.target(r, r, tips)
            if sc.objs.info("HEAD"):
                tips.append(commit_sha(sc, "HEAD", "HEAD"))
                sc.entries(ls_tree("HEAD"), "HEAD")
            scope.append("every ref, tag and commit (%d), and HEAD's tree" % sc.commits(tips))
        for r in o["refs"]:
            sc.ref_name(os.fsencode(r))   # the exact bytes given, as the shell passed them
        for v in o["envs"]:
            sc.text_env(v)
        for f in o["files"]:
            sc.text_file(f)
        if o["worktree"]:
            sc.worktree()
            scope.append("uncommitted and untracked files")
        extra = len(o["refs"]) + len(o["envs"]) + len(o["files"])
        if extra:
            scope.append("%d name(s) and text(s)" % extra)
        return report(sc, terms, scope)
    finally:
        sc.close()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except SetupError as e:
        print("leak-check: error: %s" % e, file=sys.stderr)
        sys.exit(2)
    except Exception:  # never let a traceback print data
        if not CI and os.environ.get("LEAK_CHECK_DEBUG") == "1":
            raise
        print("leak-check: error: internal error", file=sys.stderr)
        sys.exit(2)
